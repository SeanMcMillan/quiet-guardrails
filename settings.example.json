{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(pwd -P)",
      "Bash(grep *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-bash-overreach.sh\""
          }
        ]
      }
    ]
  }
}
